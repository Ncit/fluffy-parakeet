{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluffy-parakeet.local/schemas/dsl_v3.schema.json",
  "title": "Fluffy Parakeet DSL v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "duration", "nodes"],
  "properties": {
    "version": { "const": 3 },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "width": { "type": "integer", "exclusiveMinimum": 0 },
    "height": { "type": "integer", "exclusiveMinimum": 0 },
    "background": { "$ref": "#/$defs/color" },
    "assets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/asset" } },
    "styles": { "type": "object", "additionalProperties": { "$ref": "#/$defs/style" } },
    "presets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/animationPreset" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "keyframe": { "type": "object", "additionalProperties": false, "required": ["time", "value"], "properties": { "time": { "type": "number", "minimum": 0 }, "value": { "type": "number" }, "easing": { "type": "string", "enum": ["linear", "ease_in", "ease_out", "ease_in_out"] } } },
    "animatedValue": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/keyframe" } },
    "animationPreset": { "type": "object", "additionalProperties": false, "properties": { "x": { "$ref": "#/$defs/animatedValue" }, "y": { "$ref": "#/$defs/animatedValue" }, "scale_x": { "$ref": "#/$defs/animatedValue" }, "scale_y": { "$ref": "#/$defs/animatedValue" }, "rotation": { "$ref": "#/$defs/animatedValue" }, "opacity": { "$ref": "#/$defs/animatedValue" } } },
    "asset": { "type": "object", "additionalProperties": false, "required": ["type", "src"], "properties": { "type": { "type": "string", "enum": ["image", "video", "audio", "font"] }, "src": { "type": "string", "minLength": 1 } } },
    "style": { "type": "object", "additionalProperties": false, "properties": { "color": { "$ref": "#/$defs/color" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "anchor_x": { "type": "number", "minimum": 0, "maximum": 1 }, "anchor_y": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "selection": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string" }, "locked": { "type": "boolean" }, "selectable": { "type": "boolean" }, "tags": { "type": "array", "items": { "type": "string" } } } },
    "color": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
    "node": { "type": "object", "additionalProperties": false, "required": ["id", "type"], "properties": { "id": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" }, "parent_id": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" }, "type": { "type": "string", "enum": ["rect", "text", "image"] }, "asset": { "type": "string", "minLength": 1 }, "style": { "type": "string", "minLength": 1 }, "preset": { "type": "string", "minLength": 1 }, "layer": { "type": "integer" }, "start_time": { "type": "number", "minimum": 0 }, "end_time": { "type": "number", "minimum": 0 }, "selection": { "$ref": "#/$defs/selection" }, "text": { "type": "string" }, "font_size": { "type": "number", "exclusiveMinimum": 0 }, "font_family": { "type": "string" }, "font_weight": { "type": "integer", "minimum": 100, "maximum": 900 }, "align": { "type": "string", "enum": ["left", "center", "right"] }, "line_height": { "type": "number", "exclusiveMinimum": 0 }, "color": { "$ref": "#/$defs/color" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "anchor_x": { "type": "number", "minimum": 0, "maximum": 1 }, "anchor_y": { "type": "number", "minimum": 0, "maximum": 1 }, "x": { "$ref": "#/$defs/animatedValue" }, "y": { "$ref": "#/$defs/animatedValue" }, "scale_x": { "$ref": "#/$defs/animatedValue" }, "scale_y": { "$ref": "#/$defs/animatedValue" }, "rotation": { "$ref": "#/$defs/animatedValue" }, "opacity": { "$ref": "#/$defs/animatedValue" } } }
  }
}
